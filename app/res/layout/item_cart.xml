<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/item_cart_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_wheel"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_cart_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Title"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color: "
                    android:textSize="12sp"
                    android:textColor="@color/md_theme_outline"/>

                <View
                    android:id="@+id/item_cart_color_indicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/circle_shape"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/item_cart_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N/A"
                    android:textSize="12sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rim Size: "
                    android:textSize="12sp"
                    android:textColor="@color/md_theme_outline"/>

                <TextView
                    android:id="@+id/item_cart_rim_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N/A"
                    android:textSize="12sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"/>
            </LinearLayout>

            <TextView
                android:id="@+id/item_cart_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="LKR 0.00"
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/item_cart_remove"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/delete_24px"
                android:layout_gravity="end"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/item_cart_btn_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="+"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@color/md_theme_primaryContainer"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/item_cart_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="1"
                android:textAlignment="center"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/item_cart_btn_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="-"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@color/md_theme_primaryContainer"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
